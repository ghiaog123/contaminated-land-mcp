# Key for server-side drafting calls (draft_section) through OpenRouter. Never commit a real value.
OPENROUTER_API_KEY=
# OpenRouter model id used by draft_section. Default if unset: deepseek/deepseek-v4.1-flash
# Free alternative while listed: stealth/space-bunny-alpha (catalog expiry 2026-10-05; stealth models may log prompts)
SITE_ASSESS_MODEL=deepseek/deepseek-v4.1-flash
# Model id for the LLM-graded evals (optional; a different family from the drafting model is better).
SITE_ASSESS_JUDGE_MODEL=
# Set to a local Phoenix collector URL to enable tracing (optional; unset means no tracing).
PHOENIX_COLLECTOR_ENDPOINT=
